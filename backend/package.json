{
  "name": "agent-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "后端",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules --test --test-concurrency=1 --import tsx test/*.test.ts",
    "test:coverage": "node --experimental-vm-modules --test --experimental-test-coverage --test-concurrency=1 --import tsx test/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
