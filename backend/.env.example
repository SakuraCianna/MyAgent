# DeepSeek API Key，Agent 大脑用的 LLM，去 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=

# DeepSeek API 地址，一般不需要改
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# DeepSeek 模型名称，默认用 deepseek-chat
DEEPSEEK_MODEL=deepseek-v4-flash

# Tavily 搜索 API Key，search 工具用，没有则自动降级为本地 mock 数据
TAVILY_API_KEY=

# 后端服务监听端口
PORT=3001
